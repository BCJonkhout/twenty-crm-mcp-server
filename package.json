{
  "name": "twenty-crm-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Twenty CRM (PrudAI \"CATO\") tooling monorepo: shared client core, MCP server, and the `cato` CLI.",
  "type": "module",
  "workspaces": [
    "core",
    "mcp",
    "cli"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test cli/tests core/tests",
    "cato": "bun run cli/src/index.ts",
    "start": "bun run mcp/src/index.ts",
    "smoke": "bun run mcp/smoke.ts",
    "openapi:generate": "bun run cli/scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "keywords": [
    "mcp",
    "twenty",
    "crm",
    "cli",
    "cato",
    "prudai",
    "openapi",
    "typescript"
  ],
  "author": "mhenry3164",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhenry3164/twenty-crm-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/mhenry3164/twenty-crm-mcp-server/issues"
  },
  "homepage": "https://github.com/mhenry3164/twenty-crm-mcp-server#readme"
}
