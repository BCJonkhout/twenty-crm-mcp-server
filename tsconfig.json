{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["bun"],
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@twenty-crm/core": ["./core/src/index.ts"],
      "@twenty-crm/core/*": ["./core/src/*"]
    }
  },
  "include": ["core/**/*", "mcp/**/*", "cli/**/*"]
}
